# ============================================================
# Harmony AI – Spotify Backend Agent
# Copy this file to .env and fill in real values
# ============================================================

# Spotify Developer Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_real_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_real_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8080

# Scopes (space-separated)
SPOTIFY_SCOPE=user-library-read playlist-read-private playlist-modify-public playlist-modify-private user-read-private user-read-email user-top-read user-read-recently-played user-read-playback-state user-modify-playback-state

# xAI (Grok) API Configuration
# Get your key from https://console.x.ai
XAI_API_KEY=your_real_xai_api_key

# Optional: override the model (default: grok-3)
XAI_MODEL=grok-3
