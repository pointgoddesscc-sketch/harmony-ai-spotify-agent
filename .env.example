# Harmony AI – Environment Variables
# Copy to .env for local development
# On Vercel: Settings → Environment Variables (then redeploy)

# REQUIRED – from https://developer.spotify.com/dashboard → your app → Client ID
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# OPTIONAL – defaults to current origin + /callback
# VITE_REDIRECT_URI=http://127.0.0.1:5173/callback

# OPTIONAL – Edge chat Grok support
# XAI_API_KEY=
# HARMONY_SYSTEM_PROMPT=
# CHAT_CACHE_TTL=60
